#!/bin/sh
# Thorough tier: everything the fast pre-commit gate skips.
#
# precompile catches library code that no example or test calls — a consumer
# build only type-checks the `def` bodies it actually reaches.
set -u

# A push that changes only inert files (see _inert.sh) skips every check below.
. "$(dirname "$0")/_inert.sh"

# Git hands a pre-push hook one "local_ref local_sha remote_ref remote_sha"
# line per pushed ref. Any ref whose diff cannot be taken — a new branch with
# no origin/main to compare to, a remote commit missing locally — counts as
# code, so the fallback is always the full run.
zero=0000000000000000000000000000000000000000
inert=1
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a branch
    if [ "$remote_sha" = "$zero" ]; then
        base=$(git merge-base origin/main "$local_sha" 2>/dev/null) \
            || { inert=0; break; }
    else
        base=$remote_sha
    fi
    changed=$(git diff --name-only "$base" "$local_sha" 2>/dev/null) \
        || { inert=0; break; }
    for path in $changed; do
        is_inert "$path" || { inert=0; break 2; }
    done
done

if [ "$inert" = 1 ]; then
    echo "Only docs and editor config changed — skipping checks."
    exit 0
fi

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT

echo "Type-checking library..."
pixi run mojo precompile src/create -o "$out/create.mojoc" \
    || { echo "Library type-check failed — push aborted."; exit 1; }

echo "Building examples..."
examples=$(grep -rlE '^(def|fn) main' examples --include='*.mojo' | sort)
if [ -z "$examples" ]; then
    echo "No example entrypoints found — push aborted."
    exit 1
fi
echo "$examples" | xargs -P 4 -I{} sh -c \
    'pixi run mojo build -I src "{}" -o "'"$out"'/$(echo {} | tr / _).bin"' \
    || { echo "Example build failed — push aborted."; exit 1; }

echo "Running tests..."
pixi run test \
    || { echo "Tests failed — push aborted."; exit 1; }

exit 0
